# 腾讯云开发环境 ID（必填，供 Next 前端 lib/cloudbase.ts）
NEXT_PUBLIC_CLOUDBASE_ENV_ID=your-env-id

# AI 推理密钥（DeepSeek / 智谱 / Kimi / Qwen / OpenAI）仅配置在「云函数」环境变量中，
# 勿写入本文件或任何 NEXT_PUBLIC_*。见 docs/CLOUDBASE_DEPLOY.md「多模型推理环境变量」。

# Supabase / PostgreSQL（勿使用 NEXT_PUBLIC_ 前缀）
#
# Vercel Preview / Production：两项均须在 Project Settings -> Environment Variables
# 中配置（含 Preview 作用域），否则 npm install / prisma generate / npm run build 会失败。
#
# 连接池（应用连接；示例为 Supabase 6543）
# DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# 直连（与 prisma/schema.prisma 中 directUrl 对应；migrate / prisma generate 需要变量存在）
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[ref].supabase.co:5432/postgres?sslmode=require"
